{
  "name": "supermuebles-tienda",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../wrangler.tienda.jsonc --local",
    "db:migrar": "wrangler d1 migrations apply supermuebles-tienda-pruebas --config ../wrangler.tienda.jsonc --local",
    "db:migrar:nube": "wrangler d1 migrations apply supermuebles-tienda-pruebas --config ../wrangler.tienda.jsonc --remote",
    "db:precios-prueba": "wrangler d1 execute supermuebles-tienda-pruebas --config ../wrangler.tienda.jsonc --local --file scripts/solo-local-precios-de-prueba.sql",
    "test": "node --test --test-concurrency=1 test/smoke.test.mjs test/tienda.test.mjs test/admin.test.mjs",
    "publicar:pruebas": "wrangler deploy --config ../wrangler.tienda.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^7.0.2",
    "wrangler": "^4"
  }
}
