// Panel de reseñas. Es el mismo Worker que ya está en producción (`supermuebles-resenas`) y usa su misma
// base D1. Publicar desde esta carpeta REEMPLAZA el Worker en producción: no hacerlo sin el OK del dueño.
// Antes de publicar, ver README.md (el HTML pasa de la tabla `web` a src/panel.html).
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "supermuebles-resenas",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "supermuebles-resenas",
      "database_id": "4f049ea3-8fda-4598-af27-7fb0d0d7eb6b",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
